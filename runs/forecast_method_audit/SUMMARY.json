  "chronos_visit_rank": {
    "adapter_limitation": "HISTORY_ONLY passes a raw LOGW ndarray. Chronos sees visit rank (unit steps). Elapsed DAY is discarded. Two series with the same visit count and different calendar spacing are indistinguishable.",
